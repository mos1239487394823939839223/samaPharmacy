{
  "name": "pharmacy",
  "version": "0.1.0",
  "private": true,
  "description": "Pharmacy management system for a single Egyptian pharmacy",
  "main": "out/main/index.js",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs dev",
    "build": "node scripts/dev.mjs build",
    "start": "node scripts/dev.mjs preview",
    "package": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run packages/core && node scripts/test-db.mjs packages/db",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "test:core": "vitest run packages/core",
    "test:db": "node scripts/test-db.mjs packages/db",
    "test:watch": "vitest packages/core"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
