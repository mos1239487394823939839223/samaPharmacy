{
  "name": "pharmacy",
  "version": "1.0.0",
  "private": true,
  "description": "Pharmacy management system for a single Egyptian pharmacy",
  "main": "out/main/index.js",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs dev",
    "build": "node scripts/dev.mjs build",
    "start": "node scripts/dev.mjs preview",
    "package": "npm run build && electron-builder",
    "package:win": "node scripts/package-win.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run packages/core && node scripts/test-db.mjs packages/db apps/desktop",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "test:core": "vitest run packages/core",
    "test:db": "node scripts/test-db.mjs packages/db apps/desktop",
    "test:watch": "vitest packages/core"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "build": {
    "appId": "com.samapharmacy.desktop",
    "productName": "نظام إدارة الصيدلية",
    "copyright": "Copyright © 2026 Sama Pharmacy",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/**/{test,tests,*.md,*.markdown}"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "packages/db/migrations",
        "to": "migrations"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": ["dmg"],
      "icon": "build/icon.png",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "build/icon.png",
      "category": "Office"
    }
  }
}
