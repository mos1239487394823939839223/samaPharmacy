{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "noEmit": true,

    "paths": {
      "@pharmacy/shared": ["./packages/shared/src"],
      "@pharmacy/core": ["./packages/core/src"],
      "@pharmacy/db": ["./packages/db/src"],
      "@pharmacy/api": ["./packages/api/src"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/desktop/src/**/*.ts",
    "apps/renderer/src/**/*.ts",
    "apps/renderer/src/**/*.tsx",
    "electron.vite.config.ts"
  ],
  "exclude": ["node_modules", "out", "dist", "legacy"]
}
